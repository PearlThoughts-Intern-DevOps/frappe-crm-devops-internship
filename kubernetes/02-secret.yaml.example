# ============================================================
# 02-secret.yaml.example
# ============================================================
# THIS FILE IS A TEMPLATE ONLY. It contains placeholder values.
# NEVER commit a file with real passwords/tokens to Git.
#
# HOW TO USE:
#   1. Copy this file:
#        cp 02-secret.yaml.example 02-secret.yaml
#   2. Base64-encode your actual passwords:
#        echo -n 'your-secure-password' | base64
#   3. Replace the placeholder base64 values below with your encoded values.
#   4. Apply: kubectl apply -f 02-secret.yaml
#   5. The file 02-secret.yaml is listed in .gitignore — it must NEVER be committed.
#
# PLACEHOLDER BASE64 VALUES USED HERE (for reference):
#   'changeme-mariadb-root' → Y2hhbmdlbWUtbWFyaWFkYi1yb290
#   'changeme-admin'        → Y2hhbmdlbWUtYWRtaW4=
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: frappe-crm-secrets
  namespace: frappe-crm
  labels:
    app.kubernetes.io/name: frappe-crm
type: Opaque
data:
  # MariaDB root password
  # Replace with: echo -n 'your-strong-password' | base64
  MARIADB_ROOT_PASSWORD: Y2hhbmdlbWUtbWFyaWFkYi1yb290

  # Frappe admin password (used by bench new-site --admin-password)
  # Replace with: echo -n 'your-admin-password' | base64
  FRAPPE_ADMIN_PASSWORD: Y2hhbmdlbWUtYWRtaW4=
