#!/usr/bin/env bash
# Minimal stand-in for `bench`, used ONLY by the unit tests / sample-report generation.
# Supports:  bench --site <site> backup [--with-files]
set -e
if [ "$1" = "--site" ] && [ "$3" = "backup" ]; then
  site="$2"
  ts="${MOCK_TS:-$(date +%Y%m%d_%H%M%S)}"
  fsite="${site//./_}"
  dir="sites/$site/private/backups"
  mkdir -p "$dir"
  echo "-- MariaDB dump
CREATE TABLE \`tabCRM Lead\` (name varchar(140));
INSERT INTO \`tabCRM Lead\` VALUES ('LEAD-0001'),('LEAD-0002');" | gzip > "$dir/$ts-$fsite-database.sql.gz"
  echo "{\"db_name\": \"_mock\"}" > "$dir/$ts-$fsite-site_config_backup.json"
  if [ "$5" = "--with-files" ] || [ "$4" = "--with-files" ]; then
    tmp=$(mktemp -d); echo "public file" > "$tmp/logo.png"; echo "private file" > "$tmp/contract.pdf"
    tar -cf "$dir/$ts-$fsite-files.tar" -C "$tmp" logo.png
    tar -cf "$dir/$ts-$fsite-private-files.tar" -C "$tmp" contract.pdf
    rm -rf "$tmp"
  fi
  echo "Backup complete (mock)"
  exit 0
fi
echo "mock bench: unsupported args: $*" >&2
exit 1
